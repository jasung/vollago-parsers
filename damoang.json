{
  "schemaVersion": 1,
  "siteId": "damoang",
  "displayName": "다모앙 자유게시판",
  "mode": "native",
  "listUrl": "https://damoang.net/free",
  "maxItems": 100,
  "selectors": {
    "item": "a.post-row, a[href^=\"/gallery/\"]:has(h3), a:has(.lucide-pin):has(h3)",
    "title": ".post-title, [class*=\"post-title-read-\"], h3",
    "link": ":scope",
    "meta": ".mobile-meta, h3 + .text-muted-foreground > span:last-child",
    "comments": ".comment-count, .aspect-video .absolute",
    "author": ".mobile-meta > span:last-child, .text-muted-foreground > span:nth-child(3)",
    "votes": ".mobile-meta > span:first-child"
  },
  "behavior": {
    "list": { "dedupeNumericPath": true },
    "feed": {
      "directSearch": { "field": "stx", "params": { "sfl": "title" }, "pageField": "page" },
      "loginMessages": ["로그인 후 검색할 수 있습니다."],
      "loginPaths": ["/login"],
      "page": { "buttonText": "다음", "synthesizeQuery": "page" }
    }
  },
  "notes": "대표 게시판의 네이티브 목록을 지원합니다. 다른 게시판은 원문 웹 화면으로 열 수 있습니다. 본문과 현재 댓글을 앱에서 표시하고, 로그인 상태라면 앱 입력창에서 댓글을 작성합니다.",
  "verification": "device_checked",
  "checkedAt": "2026-09-05",
  "article": {
    "body": "div.space-y-6:has(> #economy-post-content)",
    "title": "h1",
    "author": "[data-slot=\"card-header\"] p.text-foreground > span",
    "comments": "#comments .comment-item",
    "commentBody": ".comment-body",
    "commentAuthor": "p.text-foreground > span",
    "remove": "video + div",
    "pollAttempts": 40,
    "pollIntervalMs": 750
  },
  "articleCheckedAt": "2026-09-05",
  "filters": {
    "ads": ".dm-mount",
    "notices": "a:has(.lucide-pin):has(h3)"
  }
}
