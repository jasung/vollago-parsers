{
  "schemaVersion": 1,
  "siteId": "mlbpark",
  "displayName": "MLB파크 인기글",
  "mode": "native",
  "listUrl": "https://mlbpark.donga.com/mp/best.php?b=bullpen&m=like",
  "maxItems": 100,
  "selectors": {
    "item": "#todayBest ul:first-of-type>.items,body:not(:has(.gather_list,#todayBest)) :is(#SmartPhone_bullpen_today .lists>.items,.lists:not(.sub_lists_today)>.items:has(.title>a.txt)),.gather_list>.items,.news_list:not(.commercial)>ul>li,.tbl_type01 tr:has(a.txt)",
    "title": ".title > a.txt, .tit a.txt, .title > a:not(.word), .t_left > a.txt",
    "link": ".title > a.txt, .tit a.txt, .title > a:not(.word), .t_left > a.txt",
    "meta": ".info, .views, .date",
    "comments": ".replycont, .replycnt",
    "author": ".nick, .user_name"
  },
  "behavior": {
    "list": { "dedupeQueryParams": ["b", "id"] },
    "feed": {
      "searchForm": { "selector": "form[name=searchForm]", "field": "query", "params": { "m": "search" }, "paramSelectors": { "b": "[name=b]" }, "select": "sct" },
      "page": { "queryKey": "p", "divisor": 30, "nextSelector": ".paging_box .page a[href*='date=']:first-of-type" }
    }
  },
  "notes": "대표 게시판의 네이티브 목록과 본문을 지원합니다.",
  "verification": "html_checked",
  "checkedAt": "2026-09-27",
  "filters": {
    "ads": "",
    "notices": ""
  },
  "article": {
    "body": "#contentDetail",
    "date": ".view_head .text3 .val",
    "author": ".text1 .nick",
    "remove": ".tool_cont"
  }
}
