{
  "schemaVersion": 1,
  "siteId": "mlbpark",
  "displayName": "MLB파크 인기글",
  "mode": "native",
  "listUrl": "https://mlbpark.donga.com/mp/",
  "maxItems": 100,
  "selectors": {
    "item": "#SmartPhone_bullpen_today ul.lists:first-of-type > li.items, .article_box .news_list:not(.commercial) > ul > li, ul.lists:not(.sub_lists_today) > li.items:has(.title > a.txt), .tbl_type01 tbody tr:has(.tit a.txt)",
    "title": ".title > a.txt, .tit a.txt, .title > a:not(.word)",
    "link": ".title > a.txt, .tit a.txt, .title > a:not(.word)",
    "meta": ".info, .views, .date",
    "comments": ".replycont, .replycnt",
    "author": ".nick"
  },
  "behavior": {
    "list": { "dedupeQueryParams": ["b", "id"] },
    "feed": {
      "searchForm": { "selector": "form[name=searchForm]", "field": "query", "params": { "m": "search" }, "paramSelectors": { "b": "[name=b]" }, "select": "sct" },
      "page": { "queryKey": "p", "divisor": 30, "excludePaths": ["/mp/honor.php"] }
    }
  },
  "notes": "대표 게시판의 네이티브 목록과 본문을 지원합니다.",
  "verification": "device_checked",
  "checkedAt": "2026-09-22",
  "filters": {
    "ads": "",
    "notices": ""
  },
  "article": {
    "body": "#contentDetail",
    "author": ".text1 .nick",
    "remove": ".tool_cont"
  }
}
