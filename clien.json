{
  "schemaVersion": 1,
  "siteId": "clien",
  "displayName": "클리앙",
  "mode": "native",
  "listUrl": "https://www.clien.net/service/group/board_all",
  "maxItems": 100,
  "selectors": {
    "item": "a.list_item, .card_item",
    "title": ".list_subject, .card_subject",
    "link": ":scope, a.card_subject",
    "meta": ".list_time",
    "comments": ".list_reply",
    "author": ".list_author",
    "votes": ""
  },
  "behavior": {
    "list": { "dedupeNumericPath": true },
    "feed": {
      "searchFromPath": { "actionPrefix": "/service/search/v2", "field": "sv", "params": { "sk": "title" } },
      "page": { "javascriptPaging": true, "queryKey": "po", "zeroBased": true }
    }
  },
  "notes": "본문을 앱 화면으로 정리합니다. 댓글은 페이지에 공개된 항목만 표시하며, 동영상 재생·댓글 작성은 원문에서 이용할 수 있습니다.",
  "verification": "device_checked",
  "checkedAt": "2026-09-22",
  "filters": {
    "ads": "[class^=\"view_top_\"],[class^=\"list_bottom_\"],a.list_item[href*=\"/hongbo/\"]",
    "notices": ".list_item.notice"
  },
  "article": {
    "body": ".post_article",
    "date": ".post_contact .contact_date, .post_contact .contact_time",
    "title": ".post_subject",
    "author": ".post_contact .contact_name",
    "comments": ".comment_row",
    "commentBody": ".comment_view",
    "commentAuthor": ".contact_name",
    "commentReply": ".re",
    "commentRecipient": ".comment_view > strong[data-role=\"highlite\"], .comment_view > strong:has(> img[data-role=\"highlite\"])"
  }
}
